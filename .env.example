# ───────────────────────────────────────────────────────────────
# Discord
# ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord
# Test guild for instant slash-command updates during development.
DISCORD_DEV_GUILD_ID=
# "guild" (default in dev), "global" (default in prod), or "both".
DISCORD_COMMANDS_SCOPE=
# Set to 1 once to wipe stale slash commands during development.
DISCORD_CLEAR_COMMANDS=

# ───────────────────────────────────────────────────────────────
# Database
# ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>@localhost:5432/michito?schema=public
SHADOW_DATABASE_URL=postgresql://<user>@localhost:5432/michito_shadow?schema=public

# ───────────────────────────────────────────────────────────────
# Redis (BullMQ + future rate-limit cache)
# ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ───────────────────────────────────────────────────────────────
# AI / Ollama
# ───────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

# ───────────────────────────────────────────────────────────────
# Pet mascot — tick cadence
# ───────────────────────────────────────────────────────────────
# Minutes between decay ticks per pet. Drop to 1 for a fast smoke-test loop.
TICK_INTERVAL_MIN=10
# Cron pattern for the worker's scan job. Every minute by default.
TICK_SCAN_PATTERN=*/1 * * * *

# ───────────────────────────────────────────────────────────────
# Rate limiting
# ───────────────────────────────────────────────────────────────
# Set to "true" to skip per-command rate limits (handy on tiny self-host servers).
RATE_LIMIT_DISABLED=

# ───────────────────────────────────────────────────────────────
# Bot ambient triggers + logging
# ───────────────────────────────────────────────────────────────
# Comma-separated trigger words (case-insensitive). Default: michi,michito,gato
BOT_TRIGGER_WORDS=
# Set to 1 to log every received message to stdout.
BOT_LOG_MESSAGES=
# Include message content in those logs (off by default for privacy).
BOT_LOG_MESSAGES_CONTENT=
# Verbose channel/guild/user metadata in message logs.
BOT_LOG_MESSAGES_VERBOSE=

# ───────────────────────────────────────────────────────────────
# /about command
# ───────────────────────────────────────────────────────────────
# "true" if this is the public/official instance. Toggles /about copy.
OFFICIAL_INSTANCE=false
# Version string shown in /about. Bump per release.
MICHITO_VERSION=0.1.0
# Repo URL shown in /about.
MICHITO_REPO_URL=https://github.com/exponentialabs/michito-bot

# ───────────────────────────────────────────────────────────────
# Web demo (apps/web)
# ───────────────────────────────────────────────────────────────
# Fixed guild id used by the web /api/rules and /api/chat routes.
WEB_DEMO_GUILD_ID=demo
# Actor id recorded as the creator of rules added through the web UI.
WEB_DEMO_USER_ID=web-demo-user
